# Copy to /etc/hwmonitor-mqtt/pve.env and keep it private; systemd reads it before
# dropping privileges to the sender's transient service identity.
# Use a dedicated read-only PVE API token and a trusted cluster CA file.
# PVE_CLUSTER_ID is the guest namespace used by this sender; bootstrap detects
# the cluster name and falls back to the local full hostname for standalone hosts.
PVE_URL=https://pve.example.invalid:8006
PVE_TOKEN_ID=monitor@pve!readonly
PVE_TOKEN_SECRET=replace-with-private-token-secret
PVE_CA_FILE=/etc/hwmonitor-mqtt/pve-root-ca.pem
PVE_CLUSTER_ID=lab
PVE_NODE=pve-node-a
